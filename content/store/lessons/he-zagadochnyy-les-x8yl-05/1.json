          "prompt": "Invite the rabbit to the party",
          "hint": "Build the rabbit's name in Hebrew. Not all letters are needed. Tap a chosen letter to put it back."
        },
        "spell-4": {
          "prompt": "Sign an invitation for the owl",
          "hint": "Build the owl's name in Hebrew. Not all letters are needed. Tap a chosen letter to put it back."
        },
        "spell-5": {
          "prompt": "All that is left is to invite the fox!",
          "hint": "Build the fox's name in Hebrew. Not all letters are needed. Tap a chosen letter to put it back."
        }
