          "prompt": "Hand out the name invitations",
          "hint": "The invitations have names in Hebrew. Find who each invitation belongs to."
        },
        "spell-1": {
          "prompt": "Sign an invitation for the bear",
          "hint": "Build the bear's name in Hebrew. Not all letters are needed. Tap a chosen letter to put it back."
        },
