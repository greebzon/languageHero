  "title": "Радужная мастерская",
  "presentation": {
    "intro": "Я Тим! В шести играх мы соберём красивую дугу из красок. Слушай английские слова и смело выбирай ответы!",
    "completionTitle": "Радуга готова!",
    "completionMessage": "Замечательно! Ты умеешь узнавать цвета и говорить слово для разноцветной дуги в небе. Продолжай играть с английским!"
  },
  "texts": {
    "en": {
      "title": "Rainbow Workshop",
      "presentation": {
        "intro": "I'm Tim! In six games, we'll make a beautiful arc of colors. Listen to the English words and choose your answers bravely!",
        "completionTitle": "The Rainbow Is Ready!",
        "completionMessage": "Great job! You can spot colors and say the word for the colorful arc in the sky. Keep playing with English!"
      },
      "exercises": {
        "ex-1": {
          "prompt": "Listen and choose the right picture.",
          "hint": "Tim says a word. Listen carefully first, then tap the picture."
        },
        "ex-2": {
          "prompt": "Match the words to the right pictures.",
          "hint": "Tim says: read the word and find its color in the picture."
        },
        "ex-3": {
          "prompt": "Build the name of the color from letters.",
          "hint": "Tim shows grass on a sunny day. Choose the letters in order."
        },
        "ex-4": {
          "prompt": "Listen and choose the right picture.",
          "hint": "Tim looks at the sky after rain. Listen to the whole word."
        },
        "ex-5": {
          "prompt": "Match the words to the right pictures.",
          "hint": "Tim puts out the paints. Each word needs its own picture."
        },
        "ex-6": {
          "prompt": "Make the name of the color from letters.",
          "hint": "Tim shows a clear daytime sky. You can leave out extra letters."
        }
      },
      "words": {
        "red": {
          "translation": "red"
        },
        "blue": {
          "translation": "blue"
        },
