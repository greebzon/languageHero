    "he": {
      "title": "סדנת הקשת",
      "presentation": {
        "intro": "אני טים! בשישה משחקים נרכיב קשת יפה מצבעים. להקשיב למילים באנגלית ולבחור תשובות באומץ!",
        "completionTitle": "הקשת מוכנה!",
        "completionMessage": "נהדר! אפשר לזהות צבעים ולומר את המילה לקשת הצבעונית בשמים. להמשיך לשחק באנגלית!"
      },
      "exercises": {
        "ex-1": {
          "prompt": "להקשיב ולבחור את התמונה הנכונה.",
          "hint": "טים אומר מילה. קודם להקשיב היטב, ואז ללחוץ על התמונה."
        },
        "ex-2": {
          "prompt": "לחבר את המילים לתמונות המתאימות.",
          "hint": "טים אומר: לקרוא את המילה ולמצוא את הצבע שלה בתמונה."
        },
        "ex-3": {
          "prompt": "להרכיב את שם הצבע מאותיות.",
          "hint": "טים מראה דשא ביום שמש. לבחור את האותיות לפי הסדר."
        },
        "ex-4": {
          "prompt": "להקשיב ולבחור את התמונה הנכונה.",
          "hint": "טים מסתכל על השמים אחרי הגשם. להקשיב למילה כולה."
        },
        "ex-5": {
          "prompt": "לחבר את המילים לתמונות המתאימות.",
          "hint": "טים מסדר את הצבעים. לכל מילה יש תמונה משלה."
        },
        "ex-6": {
          "prompt": "להרכיב את שם הצבע מאותיות.",
          "hint": "טים מראה שמים בהירים ביום. אפשר לא לבחור אותיות מיותרות."
        }
      },
