        },
        "ex-2": {
          "prompt": "לחבר את המילים לתמונות הנכונות.",
          "hint": "טים השועל: אחד עף עם זנב, והשני עשוי בידי אנשים."
        },
        "ex-3": {
          "prompt": "להרכיב את השם של משפחת כוכבים גדולה.",
          "hint": "טים השועל: יש בה המון כוכבים."
        },
        "ex-4": {
          "prompt": "להקשיב ולבחור את התמונה הנכונה.",
          "hint": "טים השועל: זה פס אש שעף מהר בשמים."
        },
        "ex-5": {
          "prompt": "לחבר את המילים לתמונות הנכונות.",
          "hint": "טים השועל: אחד הוא דרך סביב כוכב לכת, והשני הוא כוכב בהיר קרוב אלינו."
        },
        "ex-6": {
          "prompt": "לבנות מאותיות את השם של עוזר מהחלל.",
          "hint": "טים השועל: אנשים משגרים אותו גבוה מעל כדור הארץ."
        }
      },
