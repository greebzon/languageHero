      "title": "Sky Finds",
      "presentation": {
        "intro": "Tim says: “Look closely: amazing space finds are hidden in the sky!”",
        "completionTitle": "Space Finds Master!",
        "completionMessage": "Hooray! You spotted a galaxy, a meteor, and an orbit. Your English words shine bright!"
      },
      "exercises": {
        "ex-1": {
          "prompt": "Listen and choose the right picture.",
          "hint": "Tim the fox: This shines brightly in the sky during the day."
        },
        "ex-2": {
          "prompt": "Match the words to the right pictures.",
          "hint": "Tim the fox: One flies with a tail, and the other is made by people."
        },
        "ex-3": {
          "prompt": "Build the name of a big star family.",
          "hint": "Tim the fox: It has lots and lots of stars."
        },
        "ex-4": {
          "prompt": "Listen and choose the right picture.",
          "hint": "Tim the fox: This is a fiery streak that flies fast across the sky."
        },
        "ex-5": {
          "prompt": "Match the words to the right pictures.",
          "hint": "Tim the fox: One is a path around a planet, and the other is a bright star near us."
        },
        "ex-6": {
          "prompt": "Build the name of a space helper from the letters.",
          "hint": "Tim the fox: People send it high above Earth."
        }
      },
