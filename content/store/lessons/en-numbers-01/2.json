      "presentation": {
        "intro": "Tim says: “Let’s count little blocks together: one, two, three, four!”",
        "completionTitle": "First counting done!",
        "completionMessage": "Great! You can count in English from one to four. Say the words again and listen carefully."
      },
      "exercises": {
        "ex-1": {
          "prompt": "Listen and choose the picture.",
          "hint": "Tim put down one block. Listen carefully!"
        },
        "ex-2": {
          "prompt": "Match the words to the pictures.",
          "hint": "Tim is counting blocks. Find a match for each word!"
        },
        "ex-3": {
          "prompt": "Build the word from letters.",
          "hint": "Tim is holding one block. Put the letters in order!"
        },
        "ex-4": {
          "prompt": "Listen and choose the picture.",
          "hint": "Tim built a tower of four blocks. Listen to the word!"
        },
        "ex-5": {
          "prompt": "Match the words to the pictures.",
          "hint": "Tim likes to count to four. Match all the pairs!"
        },
        "ex-6": {
          "prompt": "Build the word from letters.",
          "hint": "Tim stacked three blocks. Start with the first letter!"
        }
      },
