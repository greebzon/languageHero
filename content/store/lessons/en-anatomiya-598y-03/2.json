      "title": "Helpful Hands",
      "presentation": {
        "intro": "Tim says: Reach up, bend your arm, and find new words!",
        "completionTitle": "Hands Can Do Everything!",
        "completionMessage": "Great job! Now you know hand, arm, finger, and elbow in English."
      },
      "exercises": {
        "ex-1": {
          "prompt": "Listen to the word and choose the picture.",
          "hint": "Tim the fox: It is the hand. We wave with it."
        },
        "ex-2": {
          "prompt": "Match the words to the right pictures.",
          "hint": "Tim the fox: Find the hand, finger, and elbow."
        },
        "ex-3": {
          "prompt": "Build the word from letters.",
          "hint": "Tim the fox: It is the part of the arm between the hand and shoulder."
        },
        "ex-4": {
          "prompt": "Listen to the word and choose the picture.",
          "hint": "Tim the fox: It is a small part on the hand. There are five!"
        },
        "ex-5": {
          "prompt": "Match the words to the right pictures.",
          "hint": "Tim the fox: An arm has a long part and a place where it bends."
        },
        "ex-6": {
          "prompt": "Build the word from letters.",
          "hint": "Tim the fox: It is the place on the arm that bends."
        }
      },
