    "en": {
      "title": "Friends in the Waves",
      "presentation": {
        "intro": "Hi! I'm Tim the fox. Let's meet the kind sea friends!",
        "completionTitle": "Sea Friends Found!",
        "completionMessage": "Great! You learned how to say dolphin, whale, crab, and octopus in English."
      },
      "exercises": {
        "ex-1": {
          "prompt": "Listen to the word and choose the right picture.",
          "hint": "Tim says: This friend jumps out of the water and likes to swim near ships."
        },
        "ex-2": {
          "prompt": "Match the words to the right pictures.",
          "hint": "Tim says: Find the big swimmer and the friend with claws."
        },
        "ex-3": {
          "prompt": "Build the word from letters.",
          "hint": "Tim says: This sea friend has smooth skin and a happy jump."
        },
        "ex-4": {
          "prompt": "Listen to the word and choose the right picture.",
          "hint": "Tim says: This huge friend has a tail and lives in the sea."
        },
        "ex-5": {
          "prompt": "Match the words to the right pictures.",
          "hint": "Tim says: One friend hides on the bottom, and another waves long tentacles."
        },
        "ex-6": {
          "prompt": "Build the word from letters.",
          "hint": "Tim says: This sea friend has eight long tentacles."
        }
      },
