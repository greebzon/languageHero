          "hint": "Tim says: This part of your leg bends when you sit down."
        },
        "ex-5": {
          "prompt": "Match the words to the right pictures.",
          "hint": "Tim says: Find the body parts that help us walk."
        },
        "ex-6": {
          "prompt": "Build the word from the letters.",
          "hint": "Tim says: It is the part at the bottom of your leg. It touches the ground in your shoe."
        }
