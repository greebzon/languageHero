      "title": "Tim's Face",
      "presentation": {
        "intro": "Hi! I'm Tim. Let's find the parts of the face and say them in English!",
        "completionTitle": "Face found!",
        "completionMessage": "Great job! You can name head, eye, ear, and nose in English."
      },
      "exercises": {
        "ex-1": {
          "prompt": "Listen to the word and choose the picture.",
          "hint": "Tim says: it is the whole top part of the body, where the face and hair are."
        },
        "ex-2": {
          "prompt": "Match the words to the right pictures.",
          "hint": "Tim winks and listens: find what you use to see and what you use to hear."
        },
        "ex-3": {
          "prompt": "Build the word from letters.",
          "hint": "Tim points to a small part in the middle of the face."
        },
        "ex-4": {
          "prompt": "Listen to the word and choose the picture.",
          "hint": "Tim says: you use it to see the world."
        },
        "ex-5": {
          "prompt": "Match the words to the right pictures.",
          "hint": "Tim asks you to find the head and the little nose in the pictures."
        },
        "ex-6": {
          "prompt": "Build the word from letters.",
          "hint": "Tim listens closely: this part of the face helps you hear."
        }
      },
