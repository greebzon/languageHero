  "title": "Праздник в лесу",
  "presentation": {
    "intro": "Помоги Тиму устроить праздник: проверь гостей и подпиши приглашения!",
    "completionTitle": "Праздник удался!",
    "completionMessage": "Все приглашения подписаны, и лесные друзья собрались вместе. Ты помог Тиму устроить праздник!"
  },
  "texts": {
    "en": {
      "title": "A Party in the Forest",
      "presentation": {
        "intro": "Help Tim throw a party: check the guests and write on the invitations!",
        "completionTitle": "The Party Was a Success!",
        "completionMessage": "All the invitations are written, and the forest friends are together. You helped Tim throw a party!"
      },
      "exercises": {
        "match-0": {
          "prompt": "Check the guest list",
          "hint": "There are three guests on the list. Match each English name to its owner."
        },
        "match-3": {
          "prompt": "Hand out the name invitations",
          "hint": "The invitations have English names on them. Find the owner of each invitation."
        },
        "spell-1": {
          "prompt": "Write on the bear's invitation",
          "hint": "You need to write bear on the invitation. Not all letters are needed. Tap a chosen letter to put it back."
        },
        "spell-2": {
          "prompt": "Invite the rabbit to the party",
          "hint": "You need to write rabbit on the invitation. Not all letters are needed. Tap a chosen letter to put it back."
        },
        "spell-4": {
          "prompt": "Write on the owl's invitation",
          "hint": "You need to write owl on the invitation. Not all letters are needed. Tap a chosen letter to put it back."
        },
        "spell-5": {
          "prompt": "Only the fox is left to invite!",
          "hint": "You need to write fox on the invitation. Not all letters are needed. Tap a chosen letter to put it back."
        }
      },
      "words": {
        "fox": {
          "translation": "A fox"
        },
        "owl": {
          "translation": "An owl"
        },
        "bear": {
          "translation": "A bear"
        },
        "rabbit": {
          "translation": "A rabbit"
        }
      }
    },
    "he": {
      "title": "מסיבה ביער",
      "presentation": {
        "intro": "עזרו לטים לערוך מסיבה: בדקו את האורחים וכתבו על ההזמנות!",
        "completionTitle": "המסיבה הצליחה!",
        "completionMessage": "כל ההזמנות מוכנות, וחברי היער התאספו יחד. עזרתם לטים לערוך מסיבה!"
      },
      "exercises": {
        "match-0": {
          "prompt": "בדקו את רשימת האורחים",
          "hint": "ברשימה יש שלושה אורחים. חברו כל שם באנגלית לבעלים שלו."
        },
        "match-3": {
          "prompt": "חלקו הזמנות עם שמות",
          "hint": "על ההזמנות כתובים שמות באנגלית. מצאו את הבעלים של כל הזמנה."
        },
        "spell-1": {
          "prompt": "כתבו על ההזמנה לדוב",
          "hint": "צריך לכתוב bear על ההזמנה. לא כל האותיות מתאימות. לחצו על אות שנבחרה כדי להחזיר אותה."
        },
        "spell-2": {
          "prompt": "הזמינו את הארנב למסיבה",
          "hint": "צריך לכתוב rabbit על ההזמנה. לא כל האותיות מתאימות. לחצו על אות שנבחרה כדי להחזיר אותה."
        },
        "spell-4": {
          "prompt": "כתבו על ההזמנה לינשוף",
          "hint": "צריך לכתוב owl על ההזמנה. לא כל האותיות מתאימות. לחצו על אות שנבחרה כדי להחזיר אותה."
        },
        "spell-5": {
          "prompt": "נשאר להזמין את השועל!",
          "hint": "צריך לכתוב fox על ההזמנה. לא כל האותיות מתאימות. לחצו על אות שנבחרה כדי להחזיר אותה."
        }
      },
