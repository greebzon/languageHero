HOST=127.0.0.1
PORT=3001
# Learner accounts. Generate ACCOUNT_SECRET with a cryptographic random generator (32+ chars).
ACCOUNT_SECRET=
ACCOUNT_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
ACCOUNT_SESSION_DAYS=30
# Legacy XP step, used only to preserve levels of accounts created before migration 0009.
ACCOUNT_LEVEL_STEP=300
ACCOUNT_COOKIE_SECURE=false
# smtp for real mail; file ONLY for local development; disabled sends nothing.
ACCOUNT_MAIL_MODE=disabled
ACCOUNT_MAIL_DIRECTORY=../../.data/account-mail
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Admin panel storage (docker compose up -d db). Leave empty to run the public API only.
DATABASE_URL=postgres://lingvohero:lingvohero@127.0.0.1:5433/lingvohero
# Same database, isolated schema per run; used by `pnpm test:admin` and the admin e2e test.
DATABASE_URL_TEST=postgres://lingvohero:lingvohero@127.0.0.1:5433/lingvohero
# Draft uploads live here until a publication copies them into content/store/media.
ADMIN_STORAGE_ROOT=../../.data/drafts
ADMIN_SESSION_TTL_HOURS=72
# true in production behind HTTPS.
ADMIN_COOKIE_SECURE=false
# Exact origin allowed for admin writes when the panel is not served from the API host itself.
ADMIN_ORIGIN=http://localhost:5173
# Content generation (admin panel). `fake` runs without a key; automated tests use it.
GENERATION_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-terra
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_EDIT_MODEL=
OPENAI_IMAGE_QUALITY=low
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
# Product limits (not provider limits) and the estimate/cap the worker enforces per job.
GENERATION_CONCURRENCY=3
GENERATION_MAX_EXERCISES=60
GENERATION_LESSON_SIZE=6
GENERATION_WORDS_PER_LESSON=4
GENERATION_COST_LIMIT_USD=5
OPENAI_IMAGE_COST_USD=0.04
OPENAI_TTS_COST_PER_1K_CHARS_USD=0.015
OPENAI_TEXT_COST_PER_1K_TOKENS_USD=0.01
