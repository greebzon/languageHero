# Production settings (copy to apps/api/.env on the server, chmod 600). The API refuses to
# start with NODE_ENV=production when one of the safety checks fails (see env.ts).
NODE_ENV=production
HOST=127.0.0.1
PORT=3001
# nginx on the same machine: it may set X-Forwarded-For/Proto/Host.
TRUST_PROXY=127.0.0.1

# A role without SUPERUSER/CREATEDB, a long random password; the database listens on loopback.
DATABASE_URL=postgres://lingvohero_app:CHANGE_ME@127.0.0.1:5433/lingvohero
# Never set DATABASE_URL_TEST on a server: the test suites create and drop databases.

# openssl rand -base64 48
ACCOUNT_SECRET=
# The web app's origin(s), https only; native apps send no Origin.
ACCOUNT_ORIGINS=https://lang.example.com
ACCOUNT_SESSION_DAYS=30
ACCOUNT_COOKIE_SECURE=true
ACCOUNT_MAIL_MODE=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

ADMIN_STORAGE_ROOT=/srv/lingvohero/data/drafts
ADMIN_SESSION_TTL_HOURS=12
ADMIN_COOKIE_SECURE=true
# The panel's origin when it is not served by the API itself.
ADMIN_ORIGIN=https://lang.example.com

GENERATION_PROVIDER=openai
OPENAI_API_KEY=
GENERATION_COST_LIMIT_USD=5
GENERATION_DAILY_LIMIT_USD=20
